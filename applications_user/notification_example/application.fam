# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="notification_example",  # Must be unique
    name="Notification Example",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="notification_example_app",
    requires=["gui"],
    stack_size=2 * 1024,
    fap_category="Examples",
    # Optional values
    # fap_version="0.1",
    fap_icon="notification_example.png",  # 10x10 1-bit PNG
    fap_description="Notification API demo",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/notification_example",
    fap_icon_assets="images",  # Image assets to compile for this application
)
